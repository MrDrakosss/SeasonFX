{
  "name": "seasonfx",
  "version": "0.1.0",
  "description": "Non-invasive, opt-in seasonal (holiday) effects and page themes for React sites.",
  "license": "MIT",
  "author": "Tövisháti Márk Xavér",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrDrakosss/SeasonFX.git"
  },
  "keywords": [
    "react",
    "seasonal",
    "christmas",
    "halloween",
    "particles",
    "click-effect"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/seasonfx.global.js",
  "jsdelivr": "./dist/seasonfx.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "unpkg": "./dist/seasonfx.global.js",
        "jsdelivr": "./dist/seasonfx.global.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": "./dist/seasonfx.global.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "vite --config demo/vite.config.ts",
    "docs": "typedoc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
