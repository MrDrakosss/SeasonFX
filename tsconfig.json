{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [],
    "paths": { "seasonfx": ["./src/index.ts"], "seasonfx/global": ["./src/global.ts"] }
  },
  "include": ["src", "demo"],
  "exclude": ["demo/vite.config.ts"]
}
